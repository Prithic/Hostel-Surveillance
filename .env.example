# GuardianAI (Python FastAPI) — copy to `.env` and adjust.
# Never commit a real `.env`.

GUARDIAN_SOURCE=0
GUARDIAN_CAMERA_ID=webcam-0
GUARDIAN_DEVICE=cpu
GUARDIAN_ENABLE_CAMERA=1
# Default live model is models/yolov8n.pt (COCO person). Custom hostel .pt is opt-in:
# GUARDIAN_MODEL=models/custom/yolov8s_v4_production.pt
GUARDIAN_CONF=0.5
GUARDIAN_CROWD=5
GUARDIAN_NIGHT_START=22
GUARDIAN_NIGHT_END=5
# Warden credentials for the Python API (entered at /login — not baked into the SPA)
GUARDIAN_ADMIN_EMAIL=admin@guardian.ai
GUARDIAN_ADMIN_PASSWORD=Warden@2026
GUARDIAN_SESSION_TTL=28800

# Frontend (also see frontend/.env.example)
# VITE_GUARDIAN_API_URL=http://127.0.0.1:8000

# trinity-api/ is deferred — not part of the GuardianAI product surface.
