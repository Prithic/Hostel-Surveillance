# GuardianAI / Trinity Engine — copy to `.env` and adjust.
# Never commit a real `.env`.

# Camera: 0 = default webcam, or path to an .mp4, or RTSP URL
# Judge footage examples:
#   GUARDIAN_SOURCE=videos/judge_clip.mp4
#   GUARDIAN_SOURCE=D:/USB/hostel_gate.mp4
GUARDIAN_SOURCE=0
GUARDIAN_CAMERA_ID=webcam-0
GUARDIAN_DEVICE=cpu
# Set 0 if you have no camera (API + hostel ERP still work; Security stream stays offline)
GUARDIAN_ENABLE_CAMERA=1

# Judge clips: skip empty lead-in (D03 ~180s until people appear)
# GUARDIAN_START_SEC=180
# Loiter dwell seconds (lower = faster demo alerts)
# GUARDIAN_LOITER_S=15
# Downscale wide CCTV for CPU (default 1280)
# GUARDIAN_MAX_WIDTH=1280

# Model: leave unset to use models/yolov8n.pt (Ultralytics auto-downloads on first run)
# GUARDIAN_MODEL=models/custom/yolov8s_v4_production.pt

GUARDIAN_CONF=0.5
GUARDIAN_CROWD=5
GUARDIAN_NIGHT_START=22
GUARDIAN_NIGHT_END=5
GUARDIAN_SESSION_TTL=28800

# Bootstrap accounts are created in SQLite on first API start (see README).
# Change passwords after login via Settings.

# Frontend default (also frontend/.env.example):
# VITE_GUARDIAN_API_URL=http://127.0.0.1:8000
